{
  "name": "the-hollow-oath",
  "private": true,
  "version": "1.0.0",
  "description": "The Hollow Oath — a party-based dark-fantasy browser CRPG using the D&D 2024 revised rules.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e --max-warnings 0",
    "e2e": "playwright test",
    "e2e:screens": "playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
